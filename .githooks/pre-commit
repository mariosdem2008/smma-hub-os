#!/bin/sh
LIMIT=$((10*1024*1024)) # 10 MiB
fail=0
files=$(git diff --cached --name-only --diff-filter=AM)
for f in $files; do
  if git cat-file -e ":$f" 2>/dev/null; then
    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$LIMIT" ]; then
      echo "BLOCKED: $f is $size bytes (> $LIMIT). Use Git LFS or store outside git."
      fail=1
    fi
  fi
done
if [ "$fail" -ne 0 ]; then
  echo "Commit rejected: file(s) exceed 10 MiB."
  exit 1
fi
exit 0
