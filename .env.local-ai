# Local-model testing profile — NO paid providers, NO production keys.
# Source these into edge-function / script runs to drive the SaaS's internal
# AI agents against a local Ollama server (OpenAI-compatible API).
#
# PowerShell:  Get-Content .env.local-ai | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }
#
# Ollama must be running:  ollama serve   (default http://localhost:11434)
# Instruction-following local model that does NOT emit a reasoning dump:
#   qwen2.5-coder:1.5b  (fast, good at JSON/structured agent tasks)

AI_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

AI_TEXT_MODEL_DEFAULT=qwen2.5-coder:1.5b
STRATEGY_MODEL_ID=qwen2.5-coder:1.5b
CHAT_MODEL_ID=qwen2.5-coder:1.5b

# Strategy plan publisher: keep deterministic during local smoke runs so the
# small local model isn't asked to emit the full strict StrategyPlan schema.
# Flip to "llm" to test the model-authored plan path with a larger local model.
STRATEGY_PLAN_PUBLISHER=deterministic
