# ============================================
# SMMAHUB Local Development Environment
# ============================================
# Copy this to .env.local for local development
# Run `supabase start` to get the local values

# ============================================
# PUBLIC URL (for OAuth callbacks, redirects)
# ============================================
VITE_PUBLIC_URL=http://localhost:5173

# ============================================
# LOCAL SUPABASE CONFIGURATION
# ============================================
# These values come from running `supabase start`
VITE_SUPABASE_PROJECT_ID="local"
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"

# ============================================
# NOTES FOR LOCAL DEVELOPMENT
# ============================================
# 1. Install Supabase CLI: npm install -g supabase
# 2. Run: supabase start
# 3. Copy the anon key from the output
# 4. Edge functions will use local Supabase automatically
#
# For edge function secrets locally, create:
# supabase/functions/.env with:
#   STRIPE_SECRET_KEY=sk_test_xxx
#   OPENAI_API_KEY=sk-xxx
#   META_APP_ID=xxx
#   META_APP_SECRET=xxx
#   CLIENT_PORTAL_JWT_SECRET=xxx
